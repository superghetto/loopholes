{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loopholes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "build": { "command": "npm run build" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "kv_namespaces": [{ "binding": "CONFIG","id": "9fdb32063d284b2a8eb36a3a6d2b3c7d" }],
  "durable_objects": { "bindings": [{ "name": "AUTH", "class_name": "AuthObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthObject"] }],
  "observability": { "enabled": false },
}
